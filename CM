% 12
\begin{frame}{Generalized Hooke's Law in 3D}
\small
For a general anisotropic, linearly elastic material:
\[
\begin{Bmatrix}\sigma_{xx}\\\sigma_{yy}\\\sigma_{zz}\\\tau_{yz}\\\tau_{xz}\\\tau_{xy}\end{Bmatrix}
=
\begin{bmatrix}
C_{11}&C_{12}&C_{13}&C_{14}&C_{15}&C_{16}\\
\sym&C_{22}&C_{23}&C_{24}&C_{25}&C_{26}\\
\sym&\sym&C_{33}&C_{34}&C_{35}&C_{36}\\
\sym&\sym&\sym&C_{44}&C_{45}&C_{46}\\
\sym&\sym&\sym&\sym&C_{55}&C_{56}\\
\sym&\sym&\sym&\sym&\sym&C_{66}
\end{bmatrix}
\begin{Bmatrix}\epsilon_{xx}\\\epsilon_{yy}\\\epsilon_{zz}\\\gamma_{yz}\\\gamma_{xz}\\\gamma_{xy}\end{Bmatrix}
\]
\vspace{-1mm}
\[
\{\boldsymbol{\sigma}\}=[C]\{\boldsymbol{\epsilon}\},
\qquad
\{\boldsymbol{\epsilon}\}=[S]\{\boldsymbol{\sigma}\},\quad [S]=[C]^{-1}.
\]
\end{frame}

% 13
\begin{frame}{Generalized Hooke's Law in 3D}
\small
The compliance form of the generalized Hooke's law is
\[
\begin{Bmatrix}\epsilon_{xx}\\\epsilon_{yy}\\\epsilon_{zz}\\\gamma_{yz}\\\gamma_{xz}\\\gamma_{xy}\end{Bmatrix}
=
\begin{bmatrix}
S_{11}&S_{12}&S_{13}&S_{14}&S_{15}&S_{16}\\
\sym&S_{22}&S_{23}&S_{24}&S_{25}&S_{26}\\
\sym&\sym&S_{33}&S_{34}&S_{35}&S_{36}\\
\sym&\sym&\sym&S_{44}&S_{45}&S_{46}\\
\sym&\sym&\sym&\sym&S_{55}&S_{56}\\
\sym&\sym&\sym&\sym&\sym&S_{66}
\end{bmatrix}
\begin{Bmatrix}\sigma_{xx}\\\sigma_{yy}\\\sigma_{zz}\\\tau_{yz}\\\tau_{xz}\\\tau_{xy}\end{Bmatrix}.
\]
\end{frame}

% 14
\begin{frame}{Generalized Hooke's Law in 3D}
\small
Due to equality of cross shear (from moment equilibrium in the absence of body
moments),
\[
\sigma_{ij}=\sigma_{ji},\qquad
\epsilon_{ij}=\epsilon_{ji},\quad i\ne j.
\]
Thus the stress and strain tensors are symmetric:
\[
[\sigma]=
\begin{bmatrix}
\sigma_{xx}&\tau_{xy}&\tau_{xz}\\
\sym&\sigma_{yy}&\tau_{yz}\\
\sym&\sym&\sigma_{zz}
\end{bmatrix},
\qquad
[\epsilon]=
\begin{bmatrix}
\epsilon_{xx}&\epsilon_{xy}&\epsilon_{xz}\\
\sym&\epsilon_{yy}&\epsilon_{yz}\\
\sym&\sym&\epsilon_{zz}
\end{bmatrix}.
\]
\end{frame}

% 15
\begin{frame}{Anisotropic Elasticity}
\small
From energy considerations, for a linearly elastic material the stiffness and
compliance matrices are also symmetric:
\[
C_{ij}=C_{ji},\qquad S_{ij}=S_{ji}.
\]
\[
[C]=
\begin{bmatrix}
C_{11}&C_{12}&C_{13}&C_{14}&C_{15}&C_{16}\\
\sym&C_{22}&C_{23}&C_{24}&C_{25}&C_{26}\\
\sym&\sym&C_{33}&C_{34}&C_{35}&C_{36}\\
\sym&\sym&\sym&C_{44}&C_{45}&C_{46}\\
\sym&\sym&\sym&\sym&C_{55}&C_{56}\\
\sym&\sym&\sym&\sym&\sym&C_{66}
\end{bmatrix}.
\]
\end{frame}

% 16
\begin{frame}{Anisotropic Elasticity}
\begin{center}
\Large Stiffness and compliance matrices have 21 independent elastic constants.
\end{center}
\[
N=\frac{6(6+1)}{2}=21.
\]
The symmetry of the constitutive matrices reduces the 36 entries to 21
independent constants.
\end{frame}

% 17
\begin{frame}{Planes of Material-Property Symmetry -- Monoclinic Materials}
\small
\begin{itemize}
\item A plane of material-property symmetry is a plane about which the material
properties remain unchanged under a 180$^\circ$ rotation.
\item For example, the $X$--$Y$ plane is a plane of material-property symmetry.
\end{itemize}
\begin{center}
\includegraphics[width=.5\linewidth,height=.42\textheight,keepaspectratio]{figures/s17_img01.png}
\end{center}
\end{frame}

% 18
\begin{frame}{Planes of Material-Property Symmetry -- Monoclinic Materials}
\small
Since the $Z$-plane is the plane of material-property symmetry, the stiffness
matrix remains the same in both cases. Hence stresses and strains in both
coordinate descriptions are related by the same stiffness matrix.
\[
[C]=
\begin{bmatrix}
C_{11}&C_{12}&C_{13}&C_{14}&C_{15}&C_{16}\\
\sym&C_{22}&C_{23}&C_{24}&C_{25}&C_{26}\\
\sym&\sym&C_{33}&C_{34}&C_{35}&C_{36}\\
\sym&\sym&\sym&C_{44}&C_{45}&C_{46}\\
\sym&\sym&\sym&\sym&C_{55}&C_{56}\\
\sym&\sym&\sym&\sym&\sym&C_{66}
\end{bmatrix}.
\]
\end{frame}

% 19
\begin{frame}{Planes of Material-Property Symmetry -- Monoclinic Materials}
\small
Using stress and strain transformations about the rotated axes:
\[
\{\sigma'\}=[T_\sigma]\{\sigma\},\qquad
\{\epsilon'\}=[T_\epsilon]\{\epsilon\}.
\]
For a 180$^\circ$ rotation about the symmetry-plane normal, the transformed
constitutive relation must represent the same material:
\[
[C]'=[T_\sigma][C][T_\epsilon]^{-1}=[C].
\]
\end{frame}

% 20
\begin{frame}{Planes of Material-Property Symmetry -- Monoclinic Materials}
\small
For a monoclinic material with one plane of material-property symmetry, the
stiffness matrix has the form (Voigt order: $11,22,33,23,13,12$):
\[
[C]=
\begin{bmatrix}
C_{11}&C_{12}&C_{13}&0&C_{15}&0\\
\sym&C_{22}&C_{23}&0&C_{25}&0\\
\sym&\sym&C_{33}&0&C_{35}&0\\
\sym&\sym&\sym&C_{44}&0&C_{46}\\
\sym&\sym&\sym&\sym&C_{55}&0\\
\sym&\sym&\sym&\sym&\sym&C_{66}
\end{bmatrix}.
\]
\begin{itemize}
\item The stiffness matrix consists of only 13 independent elastic constants.
\item An example of a monoclinic material is feldspar.
\end{itemize}
\end{frame}

% 21
\begin{frame}{Planes of Material-Property Symmetry -- Orthotropic Materials}
\small
If, in addition to one plane of material-property symmetry, there is another
perpendicular plane, then a third mutually perpendicular plane is also a plane
of material-property symmetry.
\vspace{2mm}
If the $Y$-plane is also a symmetry plane, inversion of the $Y$-axis gives
\[
X'=X,\qquad Y'=-Y,\qquad Z'=Z.
\]
The stiffness matrix remains unchanged under this coordinate inversion.
\end{frame}

% 22
\begin{frame}{Planes of Material-Property Symmetry -- Orthotropic Materials}
\small
The direction-cosine matrix for the coordinate transformation from
$(X,Y,Z)$ to $(X',Y',Z')$ is
\[
[a]=
\begin{bmatrix}
1&0&0\\
0&-1&0\\
0&0&1
\end{bmatrix}.
\]
Using stress and strain transformations about the rotated axes:
\[
\{\sigma'\}=[T_\sigma]\{\sigma\},\qquad
\{\epsilon'\}=[T_\epsilon]\{\epsilon\}.
\]
\end{frame}

% 23
\begin{frame}{Planes of Material-Property Symmetry -- Orthotropic Materials}
\small
For three mutually perpendicular planes of material-property symmetry, the
stiffness matrix is
\[
[C]=
\begin{bmatrix}
C_{11}&C_{12}&C_{13}&0&0&0\\
\sym&C_{22}&C_{23}&0&0&0\\
\sym&\sym&C_{33}&0&0&0\\
\sym&\sym&\sym&C_{44}&0&0\\
\sym&\sym&\sym&\sym&C_{55}&0\\
\sym&\sym&\sym&\sym&\sym&C_{66}
\end{bmatrix}.
\]
\begin{itemize}
\item Twelve elements become zero; only 9 independent elastic constants are required.
\item Examples: unidirectional lamina and rolled steel.
\end{itemize}
\end{frame}

% 24
\begin{frame}{Planes of Material-Property Symmetry -- Transversely Isotropic Materials}
\small
\begin{itemize}
\item Transversely isotropic materials are orthotropic materials with one
transverse plane of symmetry in which properties are independent of direction
(a plane of isotropy).
\item The 1-axis remains unchanged, while the 2--3 plane is rotated by an angle
$\theta$.
\end{itemize}
\[
[a]=
\begin{bmatrix}
1&0&0\\
0&\cos\theta&\sin\theta\\
0&-\sin\theta&\cos\theta
\end{bmatrix}.
\]
\end{frame}

% 25
\begin{frame}{Planes of Material-Property Symmetry -- Transversely Isotropic Materials}
\small
For transverse isotropy, rotation by any angle $\theta$ in the isotropic plane
must leave the constitutive law unchanged:
\[
[C]'=[C],\qquad [C]'=[T_\sigma][C][T_\epsilon]^{-1}.
\]
\begin{itemize}
\item Five independent elastic constants characterize a transversely isotropic material.
\item Example: UD lamina where fibres are arranged in a square array.
\end{itemize}
\end{frame}

% 26
\begin{frame}{Planes of Material-Property Symmetry -- Isotropic Materials}
\small
\begin{itemize}
\item Isotropic materials are those in which all planes are planes of material-property symmetry.
\item Two independent elastic constants are required to characterize isotropic materials.
\end{itemize}
\[
G=\frac{E}{2(1+\nu)},\qquad
\lambda=\frac{E\nu}{(1+\nu)(1-2\nu)}.
\]
\end{frame}

% 27
\begin{frame}{Generalized Hooke's Law in 3D (Isotropic)}
\small
The isotropic stiffness relation is
\[
\{\sigma\}=[C]\{\epsilon\},\qquad
[C]=
\begin{bmatrix}
\lambda+2G&\lambda&\lambda&0&0&0\\
\sym&\lambda+2G&\lambda&0&0&0\\
\sym&\sym&\lambda+2G&0&0&0\\
\sym&\sym&\sym&G&0&0\\
\sym&\sym&\sym&\sym&G&0\\
\sym&\sym&\sym&\sym&\sym&G
\end{bmatrix}.
\]
\end{frame}

% 28
\begin{frame}{Generalized Hooke's Law in 3D (Isotropic)}
\small
In terms of Young's modulus $E$ and Poisson's ratio $\nu$:
\[
\{\epsilon\}=[S]\{\sigma\},
\quad
[S]=\frac{1}{E}
\begin{bmatrix}
1&-\nu&-\nu&0&0&0\\
\sym&1&-\nu&0&0&0\\
\sym&\sym&1&0&0&0\\
\sym&\sym&\sym&2(1+\nu)&0&0\\
\sym&\sym&\sym&\sym&2(1+\nu)&0\\
\sym&\sym&\sym&\sym&\sym&2(1+\nu)
\end{bmatrix}.
\]
\end{frame}

% 29
\begin{frame}{Generalized Hooke's Law in 3D (Isotropic)}
\small
The normal stress--strain relations are
\[
\epsilon_x=\frac{1}{E}\left[\sigma_x-\nu(\sigma_y+\sigma_z)\right],
\]
\[
\epsilon_y=\frac{1}{E}\left[\sigma_y-\nu(\sigma_x+\sigma_z)\right],
\quad
\epsilon_z=\frac{1}{E}\left[\sigma_z-\nu(\sigma_x+\sigma_y)\right].
\]
The engineering shear relations are
\[
\gamma_{xy}=\frac{\tau_{xy}}{G},\quad
\gamma_{yz}=\frac{\tau_{yz}}{G},\quad
\gamma_{xz}=\frac{\tau_{xz}}{G}.
\]
\end{frame}

