% 31
\begin{frame}{Stress--Strain Relations of a Thin Lamina}
\small
For a thin lamina under plane stress:
\[
\begin{Bmatrix}\sigma_1\\\sigma_2\\\tau_{12}\end{Bmatrix}
=
\begin{bmatrix}
Q_{11}&Q_{12}&0\\
\sym&Q_{22}&0\\
\sym&\sym&Q_{66}
\end{bmatrix}
\begin{Bmatrix}\epsilon_1\\\epsilon_2\\\gamma_{12}\end{Bmatrix}.
\]
For an orthotropic lamina:
\[
Q_{11}=\frac{E_1}{1-\nu_{12}\nu_{21}},\quad
Q_{22}=\frac{E_2}{1-\nu_{12}\nu_{21}},
\]
\[
Q_{12}=\frac{\nu_{12}E_2}{1-\nu_{12}\nu_{21}},\qquad Q_{66}=G_{12}.
\]
\end{frame}

% 32
\begin{frame}{Stress--Strain Relations of a Thin Lamina}
\small
The reduced compliance relation is
\[
\begin{Bmatrix}\epsilon_1\\\epsilon_2\\\gamma_{12}\end{Bmatrix}
=
\begin{bmatrix}
1/E_1&-\nu_{12}/E_1&0\\
\sym&1/E_2&0\\
\sym&\sym&1/G_{12}
\end{bmatrix}
\begin{Bmatrix}\sigma_1\\\sigma_2\\\tau_{12}\end{Bmatrix}.
\]
The reciprocal Poisson relation is
\[
\frac{\nu_{12}}{E_1}=\frac{\nu_{21}}{E_2}.
\]
\end{frame}

% 33
\begin{frame}{Stress--Strain Relations of a Thin Lamina}
\small
For a thin lamina, the plane-stress assumption is
\[
\sigma_3=\tau_{13}=\tau_{23}=0.
\]
Hence the in-plane constitutive equations become
\[
\begin{Bmatrix}\sigma_1\\\sigma_2\\\tau_{12}\end{Bmatrix}
=
[Q]
\begin{Bmatrix}\epsilon_1\\\epsilon_2\\\gamma_{12}\end{Bmatrix},
\quad
[Q]=
\begin{bmatrix}
Q_{11}&Q_{12}&0\\
\sym&Q_{22}&0\\
\sym&\sym&Q_{66}
\end{bmatrix}.
\]
\end{frame}

% 34
\begin{frame}{Stress--Strain Relations of a Thin Lamina}
\small
The reduced stiffness coefficients for an orthotropic lamina are
\[
Q_{11}=\frac{E_1}{1-\nu_{12}\nu_{21}},\quad
Q_{22}=\frac{E_2}{1-\nu_{12}\nu_{21}},
\]
\[
Q_{12}=\frac{\nu_{12}E_2}{1-\nu_{12}\nu_{21}},\quad
Q_{66}=G_{12}.
\]
The inverse relations follow from $[S]=[Q]^{-1}$.
\end{frame}

% 35
\begin{frame}{Transformation of Stress and Strain}
\small
Let $m=\cos\theta$ and $n=\sin\theta$.
\begin{columns}[T]
\column{.48\textwidth}
\textbf{1. Stress transformation}
\[
\begin{Bmatrix}\sigma_{x'}\\\sigma_{y'}\\\tau_{x'y'}\end{Bmatrix}
=
\begin{bmatrix}
m^2&n^2&2mn\\
n^2&m^2&-2mn\\
-mn&mn&m^2-n^2
\end{bmatrix}
\begin{Bmatrix}\sigma_x\\\sigma_y\\\tau_{xy}\end{Bmatrix}.
\]
\column{.48\textwidth}
\textbf{2. Strain transformation}
\[
\begin{Bmatrix}\epsilon_{x'}\\\epsilon_{y'}\\\gamma_{x'y'}\end{Bmatrix}
=
\begin{bmatrix}
m^2&n^2&mn\\
n^2&m^2&-mn\\
-2mn&2mn&m^2-n^2
\end{bmatrix}
\begin{Bmatrix}\epsilon_x\\\epsilon_y\\\gamma_{xy}\end{Bmatrix}.
\]
\end{columns}
\end{frame}

% 36
\begin{frame}{Inverse Transformation of Stress and Strain}
\small
Let $m=\cos\theta$ and $n=\sin\theta$.
\begin{columns}[T]
\column{.48\textwidth}
\textbf{1. Inverse stress transformation}
\[
\begin{Bmatrix}\sigma_x\\\sigma_y\\\tau_{xy}\end{Bmatrix}
=
\begin{bmatrix}
m^2&n^2&-2mn\\
n^2&m^2&2mn\\
mn&-mn&m^2-n^2
\end{bmatrix}
\begin{Bmatrix}\sigma_{x'}\\\sigma_{y'}\\\tau_{x'y'}\end{Bmatrix}.
\]
\column{.48\textwidth}
\textbf{2. Inverse strain transformation}
\[
\begin{Bmatrix}\epsilon_x\\\epsilon_y\\\gamma_{xy}\end{Bmatrix}
=
\begin{bmatrix}
m^2&n^2&-mn\\
n^2&m^2&mn\\
2mn&-2mn&m^2-n^2
\end{bmatrix}
\begin{Bmatrix}\epsilon_{x'}\\\epsilon_{y'}\\\gamma_{x'y'}\end{Bmatrix}.
\]
\end{columns}
\end{frame}

% 37
\begin{frame}{Transformation of Elastic Constants}
\small
The transformed reduced stiffness matrix is
\[
[\bar Q]=[T_\sigma]^{-1}[Q][T_\epsilon].
\]
With $m=\cos\theta$ and $n=\sin\theta$, its independent terms are
\[
\bar Q_{11}=Q_{11}m^4+2(Q_{12}+2Q_{66})m^2n^2+Q_{22}n^4,
\]
\[
\bar Q_{22}=Q_{11}n^4+2(Q_{12}+2Q_{66})m^2n^2+Q_{22}m^4,
\]
\[
\bar Q_{12}=(Q_{11}+Q_{22}-4Q_{66})m^2n^2+Q_{12}(m^4+n^4).
\]
\end{frame}

% 38
\begin{frame}{Transformed Reduced Compliance}
\small
The transformed reduced compliance matrix is
\[
[\bar S]=[T_\epsilon]^{-1}[S][T_\sigma].
\]
For a lamina rotated through $\theta$, the transformed compliance coefficients
are obtained from the in-plane transformation relations. The matrix remains
symmetric:
\[
[\bar S]=
\begin{bmatrix}
\bar S_{11}&\bar S_{12}&\bar S_{16}\\
\sym&\bar S_{22}&\bar S_{26}\\
\sym&\sym&\bar S_{66}
\end{bmatrix}.
\]
\end{frame}

% 39
\begin{frame}{Strain--Displacement Equations}
\small
For small deformations in the mid-plane:
\[
\epsilon_x^0=\frac{\partial u_0}{\partial x},\qquad
\epsilon_y^0=\frac{\partial v_0}{\partial y},\qquad
\gamma_{xy}^0=\frac{\partial u_0}{\partial y}+
\frac{\partial v_0}{\partial x}.
\]
The curvatures are
\[
\kappa_x=-\frac{\partial^2 w_0}{\partial x^2},\quad
\kappa_y=-\frac{\partial^2 w_0}{\partial y^2},\quad
\kappa_{xy}=-2\frac{\partial^2 w_0}{\partial x\partial y}.
\]
\end{frame}

% 40
\begin{frame}{Strain--Displacement Equations}
\small
The fundamental strain--displacement relation of CLPT is
\[
\boxed{\{\epsilon\}=\{\epsilon^0\}+z\{\kappa\}}
\]
\[
\begin{Bmatrix}\epsilon_x\\\epsilon_y\\\gamma_{xy}\end{Bmatrix}
=
\begin{Bmatrix}\epsilon_x^0\\\epsilon_y^0\\\gamma_{xy}^0\end{Bmatrix}
+z
\begin{Bmatrix}\kappa_x\\\kappa_y\\\kappa_{xy}\end{Bmatrix}.
\]
\begin{itemize}
\item Mid-plane strain $\{\epsilon^0\}$: represents stretching of the laminate.
\item Curvature $\{\kappa\}$: represents bending.
\item Distance $z$: distance of the point from the neutral plane.
\item Total strain = stretching strain + bending strain.
\end{itemize}
\end{frame}

% 41
\begin{frame}{Stress--Strain Relation for the $k^{\mathrm{th}}$ Lamina}
\small
For the $k^{\mathrm{th}}$ lamina:
