% 10
\begin{frame}{Limitations}
\small
\begin{itemize}
\item \textbf{Anisotropy:} analysis is more complicated and difficult; it takes more time.
\item \textbf{Non-homogeneous.}
\item \textbf{Costly:} for example, fibre glass requires glass-fibre reinforcement and polyester matrix.
\item \textbf{Difficult to fabricate.}
\item \textbf{Sensitive to temperature:} thermal conductivities of matrix and fibres are different.
\item \textbf{Sensitive to moisture:} residual hygroscopic stresses.
\end{itemize}
\end{frame}

