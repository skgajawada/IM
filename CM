\begin{frame}{Composite Materials}
\small
\textcolor{red!75!black}{\textbf{Fibrous Composite:}}
\begin{itemize}
\item Wood (spirally wound cellulose fibres + lignin)
\item Bone (organic collagen fibres + small inorganic crystals, water and fats; femur)
\item Plywood
\item Fibre glass (glass fibre + polyester/epoxy/phenolic matrix)
\item Long fibrous composite (glass/Kevlar/carbon/nylon fibres + matrix)
\end{itemize}
\textcolor{red!75!black}{\textbf{Granular / Particulate Composite:}}
\begin{itemize}
\item Granite (quartz, feldspar, mica + granular phase)
\item Concrete (cement, sand and small pebbles)
\item Cermets (ceramics + metals)
\end{itemize}
\end{frame}

